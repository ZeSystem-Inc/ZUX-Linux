#!/bin/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

ifconfig lo 127.0.0.1 up
udhcpc -i eth0 >/dev/null 2>&1 || udhcpc -i enp0s3 >/dev/null 2>&1 || true

clear

if [ -f /installer/setup.elf ]; then
    /installer/setup.elf
else
    echo "HATA: /installer/setup.elf bulunamadi!"
    exec /bin/sh
fi

exec /bin/sh
