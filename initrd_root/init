#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/installer

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts

ifconfig lo 127.0.0.1 up

exec 0</dev/tty1
exec 1>/dev/tty1
exec 2>/dev/tty1

clear

mkdir -p /bin
ln -sf /installer/setup.elf /bin/setup 2>/dev/null || true

echo "=================================================="
echo "               ZUX OS PREINSTALLATION             "
echo "=================================================="
echo ""
echo "Kurulumu baslatmak icin 'setup' yazip ENTER'a basin."
echo ""

exec /bin/sh
